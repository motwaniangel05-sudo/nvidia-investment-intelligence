# Virtual environment
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Logs
logs/*.log

# Data (large / regenerable). Structure preserved via .gitkeep files
data/raw/*
data/processed/*
data/financial/*
data/market/*
data/news/*
data/documents/*
data/knowledge.db
!data/**/.gitkeep
# Keep the processed, structured CSVs we actually generate as project outputs
!data/financial/*.csv
!data/market/*.csv

# Models and outputs (regenerable)
models/checkpoints/*
outputs/reports/*
outputs/charts/*
outputs/agent_results/*
!models/**/.gitkeep
!outputs/**/.gitkeep

# OS / editor
.DS_Store
.vscode/

# Secrets
.env
# Large regenerable raw XBRL dump (rerun data_acquisition.xbrl_facts to recreate)
data/raw/sec/companyfacts_*.json

# Raw filing documents (69MB+, fully regenerable via document_downloader.py)
data/documents/*.htm

# Chunked filing text (9MB+, fully regenerable via rag/chunker.py,
# which itself depends on rag/parser.py and the downloaded documents)
data/processed/chunks_*.csv
# Exception: the much smaller 8-K chunk file is committed directly --
# useful as reference/training data for the News Agent's classifier (Phase 10)
!data/processed/chunks_*_8K.csv

# TF-IDF vector store (4.7MB, regenerable via rag/vector_store.py)
models/embeddings/tfidf_store.pkl

# Manually-labeled training data (Phase 10) -- real human-labeled work,
# not regenerable, must be tracked regardless of other data/processed/ rules
!data/processed/labeling_template.csv
