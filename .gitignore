# Virtual environment
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Logs
logs/*.log

# Data (large / regenerable). Structure preserved via .gitkeep files
data/raw/*
data/processed/*
data/financial/*
data/market/*
data/news/*
data/documents/*
data/knowledge.db
!data/**/.gitkeep
# Keep the processed, structured CSVs we actually generate as project outputs
!data/financial/*.csv
!data/market/*.csv

# Models and outputs (regenerable)
models/checkpoints/*
outputs/reports/*
outputs/charts/*
outputs/agent_results/*
!models/**/.gitkeep
!outputs/**/.gitkeep

# OS / editor
.DS_Store
.vscode/

# Secrets
.env
# Large regenerable raw XBRL dump (rerun data_acquisition.xbrl_facts to recreate)
data/raw/sec/companyfacts_*.json

# Raw filing documents (69MB+, fully regenerable via document_downloader.py)
data/documents/*.htm
